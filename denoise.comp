#version 450

// Multi-frame temporal denoising compute shader
// Uses weighted temporal accumulation with motion-aware blending

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

// Current frame (input)
layout(binding = 0, rgba8) uniform readonly image2D currentFrame;

// Previous frames (input) - array of images
layout(binding = 1, rgba8) uniform readonly image2D previousFrames[];

// Output denoised frame
layout(binding = 2, rgba8) uniform writeonly image2D outputFrame;

// Uniform buffer with denoising parameters
layout(binding = 3) uniform DenoiseParams {
    float denoisingStrength;  // 0.0 = no denoising, 1.0 = maximum
    float temporalWeight;     // Weight for temporal accumulation (0.0-1.0)
    uint numFrames;           // Number of frames to use (including current)
    uint width;               // Frame width
    uint height;              // Frame height
} params;

// Convert RGB to luminance
float luminance(vec3 color) {
    return dot(color, vec3(0.299, 0.587, 0.114));
}

// Compute color difference between two pixels
float colorDistance(vec3 a, vec3 b) {
    vec3 diff = a - b;
    return dot(diff, diff);
}

// Bilateral filter weight based on spatial and color distance
float bilateralWeight(vec2 offset, vec3 centerColor, vec3 sampleColor, float spatialSigma, float colorSigma) {
    float spatialDist = dot(offset, offset);
    float colorDist = colorDistance(centerColor, sampleColor);
    
    float spatialWeight = exp(-spatialDist / (2.0 * spatialSigma * spatialSigma));
    float colorWeight = exp(-colorDist / (2.0 * colorSigma * colorSigma));
    
    return spatialWeight * colorWeight;
}

// Temporal accumulation with motion detection
vec4 temporalDenoise(ivec2 coord, vec4 currentPixel) {
    vec3 currentColor = currentPixel.rgb;
    float currentLuma = luminance(currentColor);
    
    vec3 accumulatedColor = currentColor;
    float totalWeight = 1.0;
    
    // Accumulate from previous frames
    for (uint i = 0; i < params.numFrames - 1; i++) {
        vec4 prevPixel = imageLoad(previousFrames[i], coord);
        vec3 prevColor = prevPixel.rgb;
        float prevLuma = luminance(prevColor);
        
        // Motion detection based on luminance difference
        float lumaDiff = abs(currentLuma - prevLuma);
        float motionFactor = 1.0 - smoothstep(0.0, 0.3, lumaDiff);
        
        // Weight decreases with frame distance
        float frameWeight = params.temporalWeight * pow(0.8, float(i + 1)) * motionFactor;
        
        // Additional weight based on color similarity
        float colorSimilarity = 1.0 - min(1.0, colorDistance(currentColor, prevColor) / 0.1);
        frameWeight *= colorSimilarity;
        
        accumulatedColor += prevColor * frameWeight;
        totalWeight += frameWeight;
    }
    
    accumulatedColor /= totalWeight;
    
    // Blend between original and denoised based on strength
    vec3 denoisedColor = mix(currentColor, accumulatedColor, params.denoisingStrength);
    
    return vec4(denoisedColor, currentPixel.a);
}

// Spatial denoising using bilateral filter
vec4 spatialDenoise(ivec2 coord, vec4 currentPixel) {
    vec3 centerColor = currentPixel.rgb;
    vec3 filteredColor = vec3(0.0);
    float totalWeight = 0.0;
    
    // 3x3 kernel for spatial filtering
    int kernelSize = 1;
    float spatialSigma = 1.5;
    float colorSigma = 0.1;
    
    for (int y = -kernelSize; y <= kernelSize; y++) {
        for (int x = -kernelSize; x <= kernelSize; x++) {
            ivec2 sampleCoord = coord + ivec2(x, y);
            
            // Clamp to image bounds
            sampleCoord = clamp(sampleCoord, ivec2(0), ivec2(params.width - 1, params.height - 1));
            
            vec4 samplePixel = imageLoad(currentFrame, sampleCoord);
            vec3 sampleColor = samplePixel.rgb;
            
            vec2 offset = vec2(float(x), float(y));
            float weight = bilateralWeight(offset, centerColor, sampleColor, spatialSigma, colorSigma);
            
            filteredColor += sampleColor * weight;
            totalWeight += weight;
        }
    }
    
    filteredColor /= totalWeight;
    
    // Blend with original
    vec3 denoisedColor = mix(centerColor, filteredColor, params.denoisingStrength * 0.5);
    
    return vec4(denoisedColor, currentPixel.a);
}

// Combined temporal-spatial denoising
void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    
    // Check bounds
    if (coord.x >= int(params.width) || coord.y >= int(params.height)) {
        return;
    }
    
    // Load current pixel
    vec4 currentPixel = imageLoad(currentFrame, coord);
    
    // First apply temporal denoising
    vec4 temporallyDenoised = temporalDenoise(coord, currentPixel);
    
    // Then apply light spatial denoising to reduce remaining noise
    vec4 finalPixel = spatialDenoise(coord, temporallyDenoised);
    
    // Write output
    imageStore(outputFrame, coord, finalPixel);
}
