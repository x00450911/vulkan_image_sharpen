#version 450

// Multi-frame accumulation shader
// Combines multiple frames with weighted averaging

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0, rgba8) uniform readonly image2D frame0;
layout(binding = 1, rgba8) uniform readonly image2D frame1;
layout(binding = 2, rgba8) uniform readonly image2D frame2;
layout(binding = 3, rgba8) uniform readonly image2D frame3;
layout(binding = 4, rgba8) uniform writeonly image2D outputFrame;

layout(push_constant) uniform AccumulateParams {
    float weights[4];      // Weights for each frame
    int frameCount;        // Number of frames to accumulate
    ivec2 imageSize;       // Image dimensions
} params;

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    
    if (coord.x >= params.imageSize.x || coord.y >= params.imageSize.y) {
        return;
    }
    
    vec4 result = vec4(0.0);
    float totalWeight = 0.0;
    
    // Accumulate frames with their weights
    if (params.frameCount > 0) {
        vec4 pixel = imageLoad(frame0, coord);
        result += pixel * params.weights[0];
        totalWeight += params.weights[0];
    }
    
    if (params.frameCount > 1) {
        vec4 pixel = imageLoad(frame1, coord);
        result += pixel * params.weights[1];
        totalWeight += params.weights[1];
    }
    
    if (params.frameCount > 2) {
        vec4 pixel = imageLoad(frame2, coord);
        result += pixel * params.weights[2];
        totalWeight += params.weights[2];
    }
    
    if (params.frameCount > 3) {
        vec4 pixel = imageLoad(frame3, coord);
        result += pixel * params.weights[3];
        totalWeight += params.weights[3];
    }
    
    // Normalize by total weight
    if (totalWeight > 0.0) {
        result /= totalWeight;
    }
    
    // Write output
    imageStore(outputFrame, coord, result);
}
