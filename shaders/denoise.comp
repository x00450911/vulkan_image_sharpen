#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(binding = 0, rgba8) uniform readonly image2D uCurrentFrame;
layout(binding = 1, rgba8) uniform readonly image2D uHistoryFrame;
layout(binding = 2, rgba8) uniform writeonly image2D uOutputFrame;

layout(push_constant) uniform PushConstants {
    float blendFactor;
    float sigmaColor;      // expressed in 0-255 range
    float sigmaTemporal;   // expressed in 0-255 range
    int frameIndex;
    int historyValid;
    int useSpatialFilter;
    float padding0;
    float padding1;
} params;

const vec3 kLuma = vec3(0.299, 0.587, 0.114);

float gaussian(float x, float sigma) {
    float variance = max(sigma * sigma, 1e-6);
    return exp(-(x * x) / (2.0 * variance));
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 frameSize = imageSize(uCurrentFrame);
    if (pixel.x >= frameSize.x || pixel.y >= frameSize.y) {
        return;
    }

    vec4 current = imageLoad(uCurrentFrame, pixel);
    vec4 history = imageLoad(uHistoryFrame, pixel);

    float sigmaTemporalNorm = params.sigmaTemporal / 255.0;
    float sigmaColorNorm = params.sigmaColor / 255.0;

    float temporalWeight = 0.0;
    if (params.historyValid != 0) {
        float lumCurrent = dot(current.rgb, kLuma);
        float lumHistory = dot(history.rgb, kLuma);
        float diff = abs(lumCurrent - lumHistory);
        float attenuation = gaussian(diff, max(sigmaTemporalNorm, 1e-4));
        temporalWeight = clamp(params.blendFactor * attenuation, 0.0, 0.99);
    }

    vec3 temporalMix = mix(current.rgb, history.rgb, temporalWeight);

    if (params.useSpatialFilter != 0) {
        vec3 accum = vec3(0.0);
        float weightSum = 0.0;

        int maxX = frameSize.x - 1;
        int maxY = frameSize.y - 1;

        for (int dy = -1; dy <= 1; ++dy) {
            for (int dx = -1; dx <= 1; ++dx) {
                ivec2 neighbour = pixel + ivec2(dx, dy);
                neighbour.x = clamp(neighbour.x, 0, maxX);
                neighbour.y = clamp(neighbour.y, 0, maxY);

                vec4 sampleCurrent = imageLoad(uCurrentFrame, neighbour);
                vec4 sampleHistory = imageLoad(uHistoryFrame, neighbour);

                float neighbourWeight = 0.0;
                if (params.historyValid != 0) {
                    float lumCurrentNeighbour = dot(sampleCurrent.rgb, kLuma);
                    float lumHistoryNeighbour = dot(sampleHistory.rgb, kLuma);
                    float diffNeighbour = abs(lumCurrentNeighbour - lumHistoryNeighbour);
                    neighbourWeight = clamp(params.blendFactor *
                                                gaussian(diffNeighbour, max(sigmaTemporalNorm, 1e-4)),
                                            0.0, 0.99);
                }

                vec3 temporalNeighbour = mix(sampleCurrent.rgb, sampleHistory.rgb, neighbourWeight);

                float spatialDist2 = float(dx * dx + dy * dy);
                float spatialWeight = exp(-spatialDist2 * 0.5);  // approximates sigma_spatial ~= 1.0
                float colourDiff = length(temporalNeighbour - temporalMix);
                float colourWeight = gaussian(colourDiff, max(sigmaColorNorm, 1e-4));
                float weight = spatialWeight * colourWeight;

                accum += temporalNeighbour * weight;
                weightSum += weight;
            }
        }

        if (weightSum > 0.0) {
            temporalMix = accum / weightSum;
        }
    }

    imageStore(uOutputFrame, pixel, vec4(temporalMix, 1.0));
}
