#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer InputPixels {
    vec4 data[];
} inputPixels;

layout(std430, binding = 1) writeonly buffer OutputPixels {
    vec4 data[];
} outputPixels;

layout(push_constant) uniform PushConsts {
    int width;
    int height;
    float strength;
    float edgeThreshold;
} pushConsts;

vec3 fetchPixel(ivec2 coord) {
    int x = clamp(coord.x, 0, pushConsts.width - 1);
    int y = clamp(coord.y, 0, pushConsts.height - 1);
    int index = y * pushConsts.width + x;
    return inputPixels.data[index].rgb;
}

float luminance(vec3 color) {
    return dot(color, vec3(0.2126, 0.7152, 0.0722));
}

void main() {
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    if (gid.x >= pushConsts.width || gid.y >= pushConsts.height) {
        return;
    }

    int index = gid.y * pushConsts.width + gid.x;
    vec4 centerSample = inputPixels.data[index];
    vec3 center = centerSample.rgb;

    vec3 left = fetchPixel(gid + ivec2(-1, 0));
    vec3 right = fetchPixel(gid + ivec2(1, 0));
    vec3 up = fetchPixel(gid + ivec2(0, -1));
    vec3 down = fetchPixel(gid + ivec2(0, 1));
    vec3 upLeft = fetchPixel(gid + ivec2(-1, -1));
    vec3 upRight = fetchPixel(gid + ivec2(1, -1));
    vec3 downLeft = fetchPixel(gid + ivec2(-1, 1));
    vec3 downRight = fetchPixel(gid + ivec2(1, 1));

    float gradH = abs(luminance(right) - luminance(left));
    float gradV = abs(luminance(down) - luminance(up));
    float gradD1 = abs(luminance(upRight) - luminance(downLeft));
    float gradD2 = abs(luminance(upLeft) - luminance(downRight));
    float gradient = max(max(gradH, gradV), max(gradD1, gradD2));

    float adaptiveStrength = pushConsts.strength;
    if (pushConsts.edgeThreshold > 0.0) {
        float high = pushConsts.edgeThreshold * 4.0;
        float factor = smoothstep(pushConsts.edgeThreshold, high, gradient);
        adaptiveStrength *= factor;
    }

    vec3 crossSum = left + right + up + down;
    vec3 diagSum = upLeft + upRight + downLeft + downRight;

    vec3 laplacian = center * 4.0 - crossSum;
    vec3 diagLaplacian = center * 4.0 - diagSum;

    vec3 sharpened = center + adaptiveStrength * laplacian
                   + (adaptiveStrength * 0.25) * diagLaplacian;

    sharpened = clamp(sharpened, 0.0, 1.0);
    outputPixels.data[index] = vec4(sharpened, centerSample.a);
}
