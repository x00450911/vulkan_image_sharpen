#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(binding = 0, rgba8) uniform readonly image2D srcImg;
layout(binding = 1, rgba8) uniform writeonly image2D dstImg;

layout(std140, binding = 2) uniform Params {
    vec4 rotationMatrix;
    vec4 rotationCenter;
    vec4 sharpenParams;
    vec4 exposureParams;
    vec4 denoiseParams;
    vec4 srParams;
} params;

const ivec2 KERNEL_OFFSETS[4] = ivec2[4](
    ivec2(-1, 0),
    ivec2(1, 0),
    ivec2(0, -1),
    ivec2(0, 1)
);

void main() {
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(dstImg);
    if (gid.x >= size.x || gid.y >= size.y) {
        return;
    }

    vec4 center = imageLoad(srcImg, gid);
    float upscale = max(1.0, params.srParams.x);
    bool applyModel = params.srParams.y > 0.5;

    vec3 result = center.rgb;
    if (applyModel && upscale > 1.001) {
        vec3 laplace = vec3(0.0);
        for (int i = 0; i < 4; ++i) {
            ivec2 coord = clamp(gid + KERNEL_OFFSETS[i], ivec2(0), size - ivec2(1));
            laplace += imageLoad(srcImg, coord).rgb;
        }
        laplace = center.rgb * 4.0 - laplace;
        float strength = min(1.0, 0.25 * (upscale - 1.0));
        result = center.rgb + strength * laplace;
    }

    imageStore(dstImg, gid, vec4(clamp(result, 0.0, 1.0), center.a));
}
